# Data & artifacts (large, reproducible via scripts/, not versioned) --
# but keep the placeholder .gitkeep files so a fresh clone has the
# expected empty folder structure ready for the pipeline to fill in.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/*/
artifacts/*/*
!artifacts/*/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Environments
.venv/
venv/
env/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Kaggle credentials must never be committed
kaggle.json

# Hugging Face / torch caches
.cache/
