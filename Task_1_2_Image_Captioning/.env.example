# Copy to .env and fill in, or export these directly in your shell.
# Never commit a real .env file or kaggle.json to version control.

# Kaggle credentials (used by kagglehub and the kaggle CLI fallback).
# Alternative to setting these: place a kaggle.json file at ~/.kaggle/kaggle.json
# (downloaded from https://www.kaggle.com/settings -> API -> Create New Token).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face Hub token (used by scripts/upload_to_hub.py and, if the
# model repo is private, scripts/fetch_model_from_hub.py).
HF_TOKEN=

# Repository to push/pull trained model artifacts to/from.
HF_MODEL_REPO=your-username/flickr8k-caption-gen
